{
  "manifest_version": 3,
  "default_locale": "pt_PT",
  "name": "__MSG_extName__",
  "version": "1.0.4",
  "description": "Know where your brands come from.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "OrigEU",
    "default_popup": "popup/popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.continente.pt/*",
    "https://www.pingodoce.pt/*",
    "https://www.auchan.pt/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.continente.pt/*"],
      "js": ["content/countries.js", "content/common.js", "content/sites/sfcc-common.js", "content/sites/continente.js"],
      "css": ["content/common.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.auchan.pt/*"],
      "js": ["content/countries.js", "content/common.js", "content/sites/sfcc-common.js", "content/sites/auchan.js"],
      "css": ["content/common.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.pingodoce.pt/*"],
      "js": ["content/countries.js", "content/common.js", "content/sites/sfcc-common.js", "content/sites/pingodoce.js"],
      "css": ["content/common.css"],
      "run_at": "document_idle"
    }
  ]
}
