{
  "manifest_version": 3,
  "name": "BuyEU — Origem UE, Glúten e Lactose",
  "version": "0.1.0",
  "description": "Mostra se um produto é de origem UE e se é isento de glúten/lactose, diretamente nos sites de supermercados portugueses (Continente, Pingo Doce, Auchan).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "BuyEU"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.continente.pt/*",
    "https://www.pingodoce.pt/*",
    "https://www.auchan.pt/*",
    "https://world.openfoodfacts.org/*",
    "https://search.openfoodfacts.org/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.continente.pt/*"],
      "js": ["content/common.js", "content/sites/sfcc-common.js", "content/sites/continente.js"],
      "css": ["content/common.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.auchan.pt/*"],
      "js": ["content/common.js", "content/sites/sfcc-common.js", "content/sites/auchan.js"],
      "css": ["content/common.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.pingodoce.pt/*"],
      "js": ["content/common.js", "content/sites/pingodoce.js"],
      "css": ["content/common.css"],
      "run_at": "document_idle"
    }
  ]
}
