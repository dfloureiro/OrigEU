{
  "name": "origeu-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "origeu-brands",
      // Same database_id as backend/api/wrangler.jsonc.example — both
      // Workers must bind the same D1 database (see backend/README.md).
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "../d1/migrations"
    }
  ]
}
